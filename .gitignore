# Logs
logs
*.log
npm-debug.log*

# Dependencies
node_modules

# Build output
dist

# Generated by `rayfin env --framework vite` from rayfin/.env
.env.local

# Semantic model schema cache, rebuilt on demand
.schema/

# Short-lived Rayfin connector payload and result files (@microsoft/fabric-app-semantic-model-tools, scripts/visual-input.mjs)
.fabric-app-semantic-model-tools-*
.lyra-rayfin-*

# Rayfin local, secret-bearing, and generated files (matches the Rayfin CLI's canonical .gitignore).
# Connector results over 8 KB spill into rayfin/.temp/invoke-results and contain model data.
*.local
rayfin/.env*
rayfin/.env.secrets
rayfin/.deployments.json
rayfin/.*.tmp
rayfin/.temp/
rayfin.config.json
